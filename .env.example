# Variables d'environnement requises pour Vercel
# Copiez ce fichier en .env.local pour le développement local hors Replit

# Clerk — Authentification
# Obtenez votre clé sur https://dashboard.clerk.com
# Dans Vercel : Settings > Environment Variables
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

# Optionnel : URL de proxy Clerk (uniquement si vous utilisez un proxy custom)
# VITE_CLERK_PROXY_URL=
